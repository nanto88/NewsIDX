{
  "name": "newsidx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/src/*.test.js",
    "demo": "tsc -p . && MOCK_MODE=1 NEWSIDX_TODAY=2026-09-11 NEWSIDX_HOME=./demo node dist/scripts/demo.js",
    "serve": "tsc -p . && node --env-file-if-exists=.env dist/src/server.js",
    "demo:serve": "tsc -p . && MOCK_MODE=1 NEWSIDX_TODAY=2026-09-11 NEWSIDX_HOME=./demo node dist/src/server.js",
    "backfill": "tsc -p . && node --env-file-if-exists=.env dist/scripts/backfill-run.js",
    "probes": "tsc -p . && node --env-file-if-exists=.env dist/scripts/probes.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "better-sqlite3": "^11.3.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.2"
  }
}
