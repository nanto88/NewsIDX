# Sectors API. Placeholders only -- never commit a real key.
# A key that has ever been committed anywhere must be ROTATED, not deleted.
SECTORS_API_KEY=your-sectors-api-key

# Responses are cached in the database itself (table: api_cache). This is an
# optional READ-THROUGH to a sibling project's on-disk cache, so calls it has
# already paid for cost this project 0 credits.
# SHARED_CACHE_DIR=../sentry_fin/server/data/cache

# Watchlist shown when the URL carries no ?w=
# WATCHLIST=BBCA,BBRI,BMRI,TLKM,ASII,ANTM,ICBP,PGAS

# MOCK_MODE=1 serves fixtures with no key and no network.
# MOCK_MODE=1

# The default price-strip subject. The calendar offers IHSG (the whole exchange)
# and LQ45 (the 45 most liquid names) and defaults to IHSG. Sectors v2 documents
# no index endpoint, so run `npm run probes` (Q16) to measure which ticker
# actually returns rows; set it here and it becomes the default and joins the
# list. Unset = IHSG. A subject with no rows renders as a plain, untinted grid.
INDEX_SYMBOL=

# The /ticker FAQ is written by Claude from the rows already in the database.
# Unset = the button renders disabled and nothing is generated. MOCK_MODE
# serves a fixture FAQ instead, so the demo needs no key.
# ANTHROPIC_API_KEY=your-anthropic-api-key
# Which model writes them. Defaults to claude-sonnet-5.
# FAQ_MODEL=claude-sonnet-5
